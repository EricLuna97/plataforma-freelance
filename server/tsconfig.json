{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "outDir": "./dist"
  },
    "include": ["**/*.ts"], 
    "exclude": ["node_modules", "prisma.config.ts"]
}