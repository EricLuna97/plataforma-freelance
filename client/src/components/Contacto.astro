---
// src/components/Contacto.astro
---

<section id="contacto" class="py-16 border-t border-slate-200">
  <div class="max-w-2xl mx-auto">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold text-slate-900 mb-2">Hablemos de tu Proyecto</h2>
      <p class="text-slate-600">
        Cuéntame qué necesitas resolver o automatizar en tu negocio y definimos una propuesta.
      </p>
    </div>

    <form class="space-y-6 bg-white p-8 border border-slate-200 rounded-2xl shadow-sm">
      <div>
        <label for="nombre" class="block text-sm font-medium text-slate-700 mb-2">
          Nombre completo
        </label>
        <input 
          type="text" 
          id="nombre" 
          name="nombre" 
          placeholder="Ej: Juan Pérez"
          required 
          class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-slate-900 placeholder-slate-400"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-slate-700 mb-2">
          Correo electrónico
        </label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          placeholder="tu@empresa.com"
          required 
          class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-slate-900 placeholder-slate-400"
        />
      </div>

      <div>
        <label for="tipo_proyecto" class="block text-sm font-medium text-slate-700 mb-2">
          ¿En qué puedo ayudarte?
        </label>
        <select 
          id="tipo_proyecto" 
          name="tipo_proyecto" 
          class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-slate-900 bg-white"
        >
          <option value="landing">Sitio web o Landing Page</option>
          <option value="app">Aplicación web / Sistema a medida</option>
          <option value="mantenimiento">Mantenimiento o integración técnica</option>
          <option value="otro">Otro requerimiento</option>
        </select>
      </div>

      <div>
        <label for="mensaje" class="block text-sm font-medium text-slate-700 mb-2">
          Detalle del requerimiento
        </label>
        <textarea 
          id="mensaje" 
          name="mensaje" 
          rows="4" 
          placeholder="Describe brevemente los objetivos, plazos o funcionalidades clave..."
          required 
          class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-slate-900 placeholder-slate-400 resize-none"
        ></textarea>
      </div>

      <button 
        type="submit" 
        class="w-full py-3 px-6 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors shadow-sm cursor-pointer"
      >
        Enviar Consulta
      </button>
    </form>
  </div>
</section>