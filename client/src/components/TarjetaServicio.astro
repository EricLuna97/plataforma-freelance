---
// src/components/TarjetaServicio.astro
interface Props {
  titulo: string;
  descripcion: string;
  caracteristicas: string[];
  destacado?: boolean;
  icono: string;
}

const { titulo, descripcion, caracteristicas, destacado = false, icono } = Astro.props;
---

<div class={`relative flex flex-col p-8 rounded-2xl border ${destacado ? 'border-zinc-500 bg-zinc-800/20' : 'border-zinc-800 bg-zinc-900/30'} transition-colors hover:border-zinc-700`}>
  
  {destacado && (
    <span class="absolute -top-3 left-8 px-3 py-1 text-xs font-semibold bg-zinc-200 text-zinc-900 rounded-full">
      Más solicitado
    </span>
  )}

  <!-- Contenedor del ícono -->
    <div class="w-12 h-12 flex items-center justify-center rounded-xl border border-zinc-800 bg-zinc-900 mb-6 text-zinc-400" set:html={icono}>
</div>

  <h3 class="text-xl font-bold text-white mb-2">{titulo}</h3>
  <p class="text-sm text-zinc-400 mb-8 leading-relaxed">{descripcion}</p>

  <!-- Lista de características con borde superior -->
  <div class="mt-auto pt-6 border-t border-zinc-800/60">
    <ul class="space-y-4">
      {caracteristicas.map((item) => (
        <li class="text-sm text-zinc-400 flex items-center gap-3">
          <svg class="w-4 h-4 text-zinc-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</div>