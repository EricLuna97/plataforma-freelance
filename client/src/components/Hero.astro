---
// src/components/Hero.astro
---

<section class="relative flex flex-col items-center text-center pt-8 pb-20 md:pt-12 md:pb-24 overflow-hidden">
  
  <div class="relative z-10 flex flex-col items-center px-6">
    <!-- Imagen -->
    <div class="relative w-40 h-40 mb-8">
      <div class="absolute inset-0 bg-white/10 rounded-full blur-2xl"></div>
      <img src="https://github.com/EricLuna97.png" alt="Eric Luna" class="relative w-full h-full object-cover rounded-full border border-zinc-700/50" />
    </div>
    <!-- ... resto de tu Hero sin cambios ... -->

    <!-- Píldora de especialidad -->
    <div class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-zinc-800 bg-zinc-900/50 backdrop-blur-sm mb-6 text-xs font-mono text-zinc-400">
      <span class="text-zinc-500">&gt;_</span>
      <span>Software Developer</span>
    </div>
    
    <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tight mb-4">
      Eric Luna
    </h1>
    
    <h2 class="text-xl md:text-2xl text-zinc-400 font-medium mb-8">
      Desarrollador de Software
    </h2>
    
    <p class="text-lg text-zinc-400 max-w-2xl mb-10 leading-relaxed">
      Diseño y construyo sistemas de software, respaldados por pruebas automatizadas de principio a fin.
    </p>
    
    <div class="flex flex-col sm:flex-row items-center gap-6">
      <a 
        href="#servicios" 
        class="flex items-center gap-2 px-6 py-3 bg-zinc-100 text-zinc-900 font-medium rounded-lg hover:bg-white transition-colors"
      >
        Ver servicios
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
      
    </div>
  </div>
</section>