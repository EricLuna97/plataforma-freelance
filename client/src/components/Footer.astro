    <div>
      <p class="font-medium text-white">Eric Luna</p>
      <p class="text-zinc-500 mt-1">Soluciones de Software</p>
    </div>

    <!-- Redes Sociales y Contacto -->
    <div class="flex items-center gap-6 text-zinc-400">
        <p class="text-zinc-500 mt-1">Contáctame</p>
      <a href="URL_DE_TU_LINKEDIN" target="_blank" class="hover:text-white transition-colors" title="LinkedIn">
